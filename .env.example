APP_ENV=development

# LLM Provider: 'huggingface' (default local CPU model, zero cost/rate limits), 'mistral' (API), or 'mock'
LLM_PROVIDER=huggingface

# Local Hugging Face Model (runs on CPU)
HF_MODEL_NAME=google/flan-t5-small

# Mistral AI (Required only if LLM_PROVIDER=mistral)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Embeddings (local sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB Vector Store
CHROMA_PERSIST_DIRECTORY=./storage/chroma
CHROMA_COLLECTION_NAME=assessment_documents

# Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval & Relevance
DEFAULT_TOP_K=5
MIN_RELEVANCE_SCORE=1.45

# Upload Constraints
MAX_UPLOAD_SIZE_MB=10

# Timeouts
LLM_TIMEOUT_SECONDS=30
